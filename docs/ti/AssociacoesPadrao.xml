  <Association Identifier=".doc" ProgId="OfficeAngero.word.doc" ApplicationName="Word - Angerô" />
  <Association Identifier=".xlsx" ProgId="OfficeAngero.excel.xlsx" ApplicationName="Excel - Angerô" />
  <Association Identifier=".xlsm" ProgId="OfficeAngero.excel.xlsm" ApplicationName="Excel - Angerô" />
  <Association Identifier=".xltx" ProgId="OfficeAngero.excel.xltx" ApplicationName="Excel - Angerô" />
  <Association Identifier=".xls" ProgId="OfficeAngero.excel.xls" ApplicationName="Excel - Angerô" />
  <Association Identifier=".pptx" ProgId="OfficeAngero.powerpoint.pptx" ApplicationName="PowerPoint - Angerô" />
  <Association Identifier=".pptm" ProgId="OfficeAngero.powerpoint.pptm" ApplicationName="PowerPoint - Angerô" />
  <Association Identifier=".potx" ProgId="OfficeAngero.powerpoint.potx" ApplicationName="PowerPoint - Angerô" />
